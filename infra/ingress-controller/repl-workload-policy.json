{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListUserProjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::shashank-replit-projects",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "users/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadUserProjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::shashank-replit-projects/users/*"
    }
  ]
}
